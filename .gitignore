# Dados do Tesouro: baixados/gerados, nao versionados.
# Os brutos vem do site do Tesouro; os processados sao reconstruidos pelos parsers.
#
# Nota: as subpastas precisam ser reincluidas (!data/**/) antes dos .gitkeep,
# porque o git nao reinclui um arquivo se o diretorio-pai esta excluido.
data/**
!data/**/
!data/**/.gitkeep

# Area de rascunho da execucao assistida (briefs, relatorios, ledger)
.superpowers/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Configuracao local do Claude Code (a compartilhada, settings.json, e versionada)
.claude/settings.local.json

# Windows / OneDrive
Thumbs.db
desktop.ini
